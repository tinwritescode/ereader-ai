# OpenAI-compatible endpoint used to shorten chapters.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# WorkOS AuthKit. The API key stays on this server; the app only knows the client ID.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# The first account signing in with this verified email becomes the super admin.
SUPER_ADMIN_EMAIL=
# Optional: Vbee cloud voices (https://vbee.vn/api-docs). Without both, the app offers device voices only.
VBEE_TOKEN=
VBEE_APP_ID=
# Optional: Postgres for accounts, books and the index of sentences read aloud. Without it they live in memory.
# DATABASE_URL=postgres://postgres:postgres@localhost:55432/ereader
# Optional: an S3-compatible bucket for EPUB sources and speech audio. Without all four, files go to STORAGE_DIR.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_URL_STYLE=virtual-host   # path for LocalStack
# Optional, defaults to 3000.
# PORT=3000
# Reads in the VieNeu voice through Replicate. Leave empty to offer it not at all.
REPLICATE_API_TOKEN=
